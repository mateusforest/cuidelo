{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build && node scripts/build-html.mjs --downloads",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|downloads/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/downloads/:file",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/citizen-alarm-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "regions": ["gru1"],
  "functions": {
    "api/care-push-tick.mjs": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "cuidelo-care-alarms",
          "retryAfterSeconds": 15
        }
      ]
    }
  }
}
