{
  "name": "cuidelo",
  "version": "0.18.0",
  "private": true,
  "description": "Plataforma de saúde pública Cuidelo — base de desenvolvimento",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -p tsconfig.json",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "build:html": "tsc -p tsconfig.json && node scripts/build-html.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.5",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
